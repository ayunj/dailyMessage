NODE_ENV=development
PORT=8080

# Telegram
TELEGRAM_BOT_TOKEN=123456:ABCDEF...
# (선택) 웹훅 바디 위변조 방지용. 헤더 X-Telegram-Bot-Api-Secret-Token 값과 맞춰주세요.
TELEGRAM_WEBHOOK_SECRET=change-me

# Firestore
# Cloud Run에서는 Workload Identity/서비스계정 권장.
# 로컬에서 키 파일을 쓸 경우:
GOOGLE_APPLICATION_CREDENTIALS=C:\\path\\to\\service-account.json
FIRESTORE_COLLECTION=telegram_chats

# Gemini
GEMINI_API_KEY=change-me
GEMINI_MODEL=gemini-1.5-flash

# Jobs
# /jobs/* 호출 보호용. (Cloud Scheduler에서 헤더로 같이 보내세요)
JOBS_API_KEY=change-me-change-me-change-me

